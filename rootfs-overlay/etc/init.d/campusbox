#!/bin/sh /etc/rc.common
# procd 守护：cb-start 是长驻脚本（末尾挂着各个守护循环），
# 它本身退出才重启；单个子系统挂了由各自的子进程循环自愈，不靠整体重启。
START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/cb-start
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger campusbox
}

reload_service() {
    stop
    start
}
